@{
    var title = ViewData["Title"] as string ?? "TrackHive";
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;
    bool isIT = User?.IsInRole("IT") ?? false;
    bool isHR = User?.IsInRole("HR") ?? false;
    bool isEmployee = User?.IsInRole("Employee") ?? false;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="theme-color" content="#0d6efd" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="~/css/site.css" rel="stylesheet" />
    @RenderSection("HeadContent", required: false)
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">TrackHive</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnav" aria-controls="topnav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="topnav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Register (IT)</a></li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (!isAuth)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Login">Sign in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                    }
                    else
                    {
                        @* Role-aware dashboard link *@
                        @if (isIT)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        }
                        else if (isHR)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="HrDashboard" asp-action="Index">Dashboard</a>
                        }
                        else if (isEmployee)
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="EmployeeDashboard" asp-action="Index">Dashboard</a>
                        }

                        <a class="btn btn-primary btn-sm" asp-controller="Profile" asp-action="Index">My profile</a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm" type="submit">Sign out</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="text-center text-secondary small py-4 border-top bg-white">
        © @DateTime.UtcNow.Year TrackHive
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/pwa.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

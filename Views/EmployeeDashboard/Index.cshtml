@using TrackHive.Models
@model EmployeeAttendanceViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "~/Views/Shared/_Layout.App.cshtml";

    string FormatTime(DateTimeOffset? value) => value is null ? "—" : value.Value.ToLocalTime().ToString("g");
    string StatusFor(AttendanceDayViewModel day)
    {
        if (!day.CheckInTime.HasValue) return "Absent";
        if (!day.CheckOutTime.HasValue) return "In progress";
        return "Complete";
    }
}
<div class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h5 mb-2">Welcome, @Model.UserName</h1>
        <div class="text-secondary">Organization: <strong>@Model.OrganizationName</strong></div>

        @if (TempData["AttendanceMessage"] is string success)
        {
            <div class="alert alert-success mt-3 mb-0" role="alert">@success</div>
        }
        else if (TempData["AttendanceError"] is string error)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">@error</div>
        }
        else
        {
            <p class="mt-3 mb-0">Track your daily attendance below.</p>
        }
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6">Today's attendance</h2>

                @if (Model.Today is null)
                {
                    <p class="text-secondary mb-3">You haven't checked in today.</p>
                }
                else
                {
                    <dl class="row mb-3 small">
                        <dt class="col-5 text-secondary">Check-in</dt>
                        <dd class="col-7 mb-2">@FormatTime(Model.Today.CheckInTime)</dd>
                        <dt class="col-5 text-secondary">Check-out</dt>
                        <dd class="col-7 mb-0">@FormatTime(Model.Today.CheckOutTime)</dd>
                    </dl>
                }

                <div class="d-flex gap-2">
                    <form asp-action="CheckIn" method="post">
                        <button type="submit" class="btn btn-primary" @(Model.CanCheckIn ? string.Empty : "disabled")>Check In</button>
                    </form>
                    <form asp-action="CheckOut" method="post">
                        <button type="submit" class="btn btn-outline-primary" @(Model.CanCheckOut ? string.Empty : "disabled")>Check Out</button>
                    </form>
                </div>
                <p class="mt-3 mb-0 text-muted small">Attendance times are recorded in your organization's timezone.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6">Recent attendance</h2>
                @if (Model.RecentRecords.Count == 0)
                {
                    <p class="text-secondary mb-0">No attendance has been recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Check-in</th>
                                    <th scope="col">Check-out</th>
                                    <th scope="col" class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.RecentRecords)
                                {
                                    <tr>
                                        <td>@record.Date.ToString("MMM d, yyyy")</td>
                                        <td>@FormatTime(record.CheckInTime)</td>
                                        <td>@FormatTime(record.CheckOutTime)</td>
                                        <td class="text-end">
                                            <span class="badge @(StatusFor(record) switch
                                            {
                                                "Complete" => "text-bg-success",
                                                "In progress" => "text-bg-warning",
                                                _ => "text-bg-secondary"
                                            })">@StatusFor(record)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

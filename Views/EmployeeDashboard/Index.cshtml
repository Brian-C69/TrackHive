@using TrackHive.Models
@model EmployeeAttendanceViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "~/Views/Shared/_Layout.App.cshtml";

    var certificateMessage = TempData["CertificateMessage"] as string;
    var certificateError = TempData["CertificateError"] as string;

    string FormatTime(DateTimeOffset? value) => value is null ? "—" : value.Value.ToLocalTime().ToString("g");
    string StatusFor(AttendanceDayViewModel day)
    {
        if (!day.CheckInTime.HasValue) return "Absent";
        if (!day.CheckOutTime.HasValue) return "In progress";
        return "Complete";
    }
    string FormatDate(DateOnly value) => value.ToString("MMM d, yyyy");
    string FormatDateRange(DateOnly start, DateOnly end)
    {
        if (start == end) return FormatDate(start);
        if (start.Year == end.Year)
        {
            return $"{start:MMM d} – {end:MMM d, yyyy}";
        }
        return $"{FormatDate(start)} – {FormatDate(end)}";
    }
    string LeaveStatusLabel(LeaveRequestStatus status) => status switch
    {
        LeaveRequestStatus.Pending => "Pending",
        LeaveRequestStatus.Approved => "Approved",
        LeaveRequestStatus.Rejected => "Rejected",
        LeaveRequestStatus.ApprovedAwaitingCertificate => "Awaiting certificate",
        LeaveRequestStatus.AwaitingCertificateReview => "Certificate submitted",
        LeaveRequestStatus.CertificateRejected => "Certificate rejected",
        _ => status.ToString()
    };
    string LeaveStatusClass(LeaveRequestStatus status) => status switch
    {
        LeaveRequestStatus.Approved => "text-bg-success",
        LeaveRequestStatus.Pending => "text-bg-warning",
        LeaveRequestStatus.Rejected => "text-bg-danger",
        LeaveRequestStatus.CertificateRejected => "text-bg-danger",
        LeaveRequestStatus.ApprovedAwaitingCertificate => "text-bg-primary",
        LeaveRequestStatus.AwaitingCertificateReview => "text-bg-info",
        _ => "text-bg-secondary"
    };
    string LeaveTypeLabel(LeaveType type) => type switch
    {
        LeaveType.Annual => "Annual leave",
        LeaveType.Sick => "Sick leave",
        LeaveType.Emergency => "Emergency leave",
        LeaveType.Unpaid => "Unpaid leave",
        _ => "Other leave"
    };
}
<div class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h5 mb-2">Welcome, @Model.UserName</h1>
        <div class="text-secondary">Organization: <strong>@Model.OrganizationName</strong></div>

        @if (TempData["AttendanceMessage"] is string success)
        {
            <div class="alert alert-success mt-3 mb-0" role="alert">@success</div>
        }
        else if (TempData["AttendanceError"] is string error)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">@error</div>
        }
        else
        {
            <p class="mt-3 mb-0">Track your daily attendance below.</p>
        }
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6">Today's attendance</h2>

                @if (Model.Today is null)
                {
                    <p class="text-secondary mb-3">You haven't checked in today.</p>
                }
                else
                {
                    <dl class="row mb-3 small">
                        <dt class="col-5 text-secondary">Check-in</dt>
                        <dd class="col-7 mb-2">@FormatTime(Model.Today.CheckInTime)</dd>
                        <dt class="col-5 text-secondary">Check-out</dt>
                        <dd class="col-7 mb-0">@FormatTime(Model.Today.CheckOutTime)</dd>
                    </dl>
                }

                <div class="d-flex gap-2">
                    <form asp-action="CheckIn" method="post">
                        <button type="submit" class="btn btn-primary" @(Model.CanCheckIn ? string.Empty : "disabled")>Check In</button>
                    </form>
                    <form asp-action="CheckOut" method="post">
                        <button type="submit" class="btn btn-outline-primary" @(Model.CanCheckOut ? string.Empty : "disabled")>Check Out</button>
                    </form>
                </div>
                <p class="mt-3 mb-0 text-muted small">Attendance times are recorded in your organization's timezone.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6">Recent attendance</h2>
                @if (Model.RecentRecords.Count == 0)
                {
                    <p class="text-secondary mb-0">No attendance has been recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Check-in</th>
                                    <th scope="col">Check-out</th>
                                    <th scope="col" class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.RecentRecords)
                                {
                                    <tr>
                                        <td>@record.Date.ToString("MMM d, yyyy")</td>
                                        <td>@FormatTime(record.CheckInTime)</td>
                                        <td>@FormatTime(record.CheckOutTime)</td>
                                        <td class="text-end">
                                            <span class="badge @(StatusFor(record) switch
                                            {
                                                "Complete" => "text-bg-success",
                                                "In progress" => "text-bg-warning",
                                                _ => "text-bg-secondary"
                                            })">@StatusFor(record)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h6">Leave summary</h2>
                <dl class="row small mb-3">
                    <dt class="col-6 text-secondary">Annual entitlement</dt>
                    <dd class="col-6 mb-2">@Model.LeaveBalance.AnnualEntitlement day(s)</dd>
                    <dt class="col-6 text-secondary">Used</dt>
                    <dd class="col-6 mb-2">@Model.LeaveBalance.UsedDays day(s)</dd>
                    <dt class="col-6 text-secondary">Pending</dt>
                    <dd class="col-6 mb-2">@Model.LeaveBalance.PendingDays day(s)</dd>
                    <dt class="col-6 text-secondary">Available</dt>
                    <dd class="col-6 mb-0">@Model.LeaveBalance.RemainingDays day(s)</dd>
                </dl>

                @if (TempData["LeaveMessage"] is string leaveSuccess)
                {
                    <div class="alert alert-success" role="alert">@leaveSuccess</div>
                }
                else if (TempData["LeaveError"] is string leaveError)
                {
                    <div class="alert alert-danger" role="alert">@leaveError</div>
                }
                else
                {
                    <p class="text-secondary small">Pending requests are deducted from your available balance.</p>
                }

                <form asp-action="ApplyLeave" method="post" class="row g-3 mt-1">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-6">
                        <label asp-for="LeaveApplication.StartDate" class="form-label">Start</label>
                        <input asp-for="LeaveApplication.StartDate" class="form-control" type="date" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LeaveApplication.EndDate" class="form-label">End</label>
                        <input asp-for="LeaveApplication.EndDate" class="form-control" type="date" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LeaveApplication.LeaveType" class="form-label">Type</label>
                        <select asp-for="LeaveApplication.LeaveType" class="form-select" asp-items="Html.GetEnumSelectList<LeaveType>()"></select>
                        <span asp-validation-for="LeaveApplication.LeaveType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="LeaveApplication.Reason" class="form-label">Reason (optional)</label>
                        <textarea asp-for="LeaveApplication.Reason" class="form-control" rows="3" maxlength="500"></textarea>
                        <div class="form-text">Provide context for HR approvals.</div>
                    </div>
                    <div class="col-12 d-grid d-sm-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit request</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="h6 mb-0">Leave requests</h2>
                    <span class="badge rounded-pill bg-light text-dark">@Model.LeaveRequests.Count total</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(certificateMessage))
                {
                    <div class="alert alert-success" role="alert">@certificateMessage</div>
                }
                else if (!string.IsNullOrWhiteSpace(certificateError))
                {
                    <div class="alert alert-danger" role="alert">@certificateError</div>
                }

                @if (Model.LeaveRequests.Count == 0)
                {
                    <p class="text-secondary mb-0">No leave requests submitted yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Dates</th>
                                    <th scope="col">Type</th>
                                    <th scope="col" class="text-center">Days</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Submitted</th>
                                    <th scope="col">Reviewed by</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.LeaveRequests)
                                {
                                    <tr>
                                        <td>
                                            <div>@FormatDateRange(request.StartDate, request.EndDate)</div>
                                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                                            {
                                                <div class="text-secondary small">@request.Reason</div>
                                            }

                                            @if (request.RequiresMedicalCertificate)
                                            {
                                                <div class="mt-2">
                                                    <div class="text-secondary small mb-2">
                                                        Medical certificate status:
                                                        <strong>@LeaveStatusLabel(request.Status)</strong>
                                                    </div>

                                                    @if (request.Documents.Count > 0)
                                                    {
                                                        <ul class="list-unstyled small mb-2">
                                                            @foreach (var document in request.Documents)
                                                            {
                                                                <li>
                                                                    <a class="link-primary" href="@document.DownloadAction" target="_blank" rel="noopener">
                                                                        @document.FileName
                                                                    </a>
                                                                    <span class="text-secondary">(@document.UploadedAt.ToLocalTime():MMM d, yyyy h:mm tt)</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }

                                                    @if (request.AwaitingEmployeeUpload)
                                                    {
                                                        if (request.Status == LeaveRequestStatus.CertificateRejected)
                                                        {
                                                            <div class="alert alert-warning py-2 px-3 small mb-2">
                                                                HR requested a new medical certificate. Please upload a replacement.
                                                            </div>
                                                        }

                                                        <form asp-action="SubmitMedicalCertificate" method="post" enctype="multipart/form-data" class="leave-document-form">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="requestId" value="@request.Id" />
                                                            <div class="leave-dropzone" data-dropzone>
                                                                <p class="fw-semibold mb-1">Drag &amp; drop medical certificate</p>
                                                                <p class="text-secondary small mb-2">Upload images or PDF documents. Each file must be 5&nbsp;MB or smaller. You can upload multiple files at once.</p>
                                                                <div class="leave-dropzone-files text-secondary small"></div>
                                                                <input class="leave-dropzone-input" type="file" name="files" multiple accept="image/*,.pdf" />
                                                            </div>
                                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                                <button type="submit" class="btn btn-sm btn-primary">Submit certificate</button>
                                                            </div>
                                                        </form>
                                                    }
                                                    else if (request.AwaitingHrReview)
                                                    {
                                                        @{ 
                                                            var latest = request.Documents.OrderByDescending(d => d.UploadedAt).FirstOrDefault();
                                                            var submittedOn = latest?.UploadedAt.ToLocalTime() ?? request.CreatedAt.ToLocalTime();
                                                        }
                                                        <div class="alert alert-info py-2 px-3 small mb-0">
                                                            Submitted to HR on @submittedOn:MMM d, yyyy h:mm tt.
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div>@LeaveTypeLabel(request.Type)</div>
                                            @if (request.RequiresMedicalCertificate)
                                            {
                                                <div class="text-secondary small">Medical certificate required</div>
                                            }
                                        </td>
                                        <td class="text-center">@request.TotalDays</td>
                                        <td>
                                            <span class="badge @LeaveStatusClass(request.Status)">@LeaveStatusLabel(request.Status)</span>
                                        </td>
                                        <td>
                                            <div>@request.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                            <div class="text-secondary small">@request.CreatedAt.ToLocalTime().ToString("t")</div>
                                        </td>
                                        <td>
                                            @if (request.Status == LeaveRequestStatus.Pending)
                                            {
                                                <span class="text-secondary">Pending</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(request.ReviewedByName))
                                            {
                                                <div>@request.ReviewedByName</div>
                                                @if (request.ReviewedAt is { } reviewedAt)
                                                {
                                                    <div class="text-secondary small">@reviewedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section HeadContent {
    <style>
        .leave-dropzone {
            border: 2px dashed #94a3b8;
            border-radius: 0.75rem;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            background-color: #f8fafc;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

        .leave-dropzone.drag-over {
            border-color: #2563eb;
            background-color: #e0f2fe;
        }

        .leave-dropzone-input {
            display: none;
        }

        .leave-dropzone-files {
            min-height: 1.5rem;
        }
    </style>
}

@section Scripts {
    <script src="~/js/leave-documents.js"></script>
}


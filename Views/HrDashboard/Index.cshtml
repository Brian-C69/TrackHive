@model TrackHive.Models.HrDashboardViewModel
@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "~/Views/Shared/_Layout.App.cshtml";
    var orgName = Model.OrganizationName;
    string FormatDate(DateOnly value) => value.ToString("MMM d, yyyy");
    string FormatDateRange(DateOnly start, DateOnly end)
    {
        if (start == end) return FormatDate(start);
        if (start.Year == end.Year)
        {
            return $"{start:MMM d} – {end:MMM d, yyyy}";
        }
        return $"{FormatDate(start)} – {FormatDate(end)}";
    }
}
<div class="row">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h1 class="h5 mb-2">Welcome, HR</h1>
                <div class="text-secondary">Organization: <strong>@orgName</strong></div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="h5 mb-0">Pending leave approvals</h2>
                    <span class="badge rounded-pill bg-light text-dark">@Model.PendingLeaveRequests.Count pending</span>
                </div>

                @if (TempData["LeaveActionMessage"] is string leaveSuccess)
                {
                    <div class="alert alert-success" role="alert">@leaveSuccess</div>
                }
                else if (TempData["LeaveActionError"] is string leaveError)
                {
                    <div class="alert alert-danger" role="alert">@leaveError</div>
                }

                @if (Model.PendingLeaveRequests.Count == 0)
                {
                    <p class="text-secondary mb-0">No leave requests are waiting for approval.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Employee</th>
                                    <th scope="col">Dates</th>
                                    <th scope="col" class="text-center">Days</th>
                                    <th scope="col">Balance</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.PendingLeaveRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@request.EmployeeName</div>
                                            <div class="text-secondary small">Requested @request.RequestedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                        </td>
                                        <td>
                                            <div>@FormatDateRange(request.StartDate, request.EndDate)</div>
                                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                                            {
                                                <div class="text-secondary small">@request.Reason</div>
                                            }
                                        </td>
                                        <td class="text-center">@request.TotalDays</td>
                                        <td>
                                            <div>@request.AnnualEntitlement day(s) / year</div>
                                            <div class="text-secondary small">Available after approval: @request.AvailableDays day(s)</div>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="ApproveLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.RequestId" />
                                                <button type="submit" class="btn btn-sm btn-success me-2">Approve</button>
                                            </form>
                                            <form asp-action="RejectLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.RequestId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Invite Employee</h2>
                <p class="text-secondary">An email with a temporary password will be sent.</p>

                @if (!string.IsNullOrWhiteSpace(Model.Invite.SuccessMessage))
                {
                    <div class="alert alert-success" role="alert">@Model.Invite.SuccessMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Invite.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.Invite.ErrorMessage</div>
                }

                <form asp-action="InviteEmployee" asp-controller="HrDashboard" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label asp-for="Invite.Name" class="form-label"></label>
                        <input asp-for="Invite.Name" class="form-control" />
                        <span asp-validation-for="Invite.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Invite.Email" class="form-label"></label>
                        <input asp-for="Invite.Email" class="form-control" />
                        <span asp-validation-for="Invite.Email" class="text-danger"></span>
                    </div>
                    <div class="col-12 d-grid d-sm-flex gap-2">
                        <button type="submit" class="btn btn-primary">Send Invite</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Leave entitlements</h2>
                @if (Model.LeaveSummaries.Count == 0)
                {
                    <p class="text-secondary mb-0">No employees found yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Employee</th>
                                    <th scope="col" class="text-center">Used</th>
                                    <th scope="col" class="text-center">Pending</th>
                                    <th scope="col" class="text-center">Available</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var summary in Model.LeaveSummaries)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@summary.EmployeeName</div>
                                            <div class="text-secondary small">Entitlement: @summary.AnnualEntitlement day(s)</div>
                                        </td>
                                        <td class="text-center">@summary.UsedDays</td>
                                        <td class="text-center">@summary.PendingDays</td>
                                        <td class="text-center">@summary.AvailableDays</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="fw-semibold mb-2">Next steps</div>
                <ol class="text-secondary small mb-0">
                    <li>Employee logs in with temp password.</li>
                    <li>Employee must change password on first login.</li>
                    <li>Track attendance and manage leave requests.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

